rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidPublicUid(val) {
      return val is string && val.matches('^[1-9][0-9]{5}$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && (
        request.auth.token.email_verified == true ||
        request.auth.token.firebase.sign_in_provider == 'custom'
      );
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll([
          'uid',
          'email',
          'photoURL',
          'displayName',
          'balance',
          'referralCode',
          'referredBy',
          'referredByCode',
          'referralCount',
          'referralBonusEarned',
          'colourWinStreak',
          'jhandiWinStreak',
          'lastResetAtMs',
          'followBonusClaimed',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'publicUid',
          'email',
          'mobile',
          'phoneNumber',
          'authMethod',
          'photoURL',
          'displayName',
          'balance',
          'referralCode',
          'referredBy',
          'referredByCode',
          'referralCount',
          'referralBonusEarned',
          'colourWinStreak',
          'jhandiWinStreak',
          'chickenWinStreak',
          'lastResetAtMs',
          'followBonusClaimed',
          'createdAt',
          'updatedAt'
        ])
        && data.uid is string
        && data.uid == request.auth.uid
        && (!('publicUid' in data) || isValidPublicUid(data.publicUid))
        && data.email is string
        && data.email.size() >= 5
        && data.email.size() <= 254
        && (!('mobile' in data) || (data.mobile is string && data.mobile.size() <= 15))
        && (!('phoneNumber' in data) || (data.phoneNumber is string && data.phoneNumber.size() <= 20))
        && (!('authMethod' in data) || (data.authMethod is string && data.authMethod in ['email', 'mobile']))
        && data.photoURL is string
        && data.photoURL.size() <= 512
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 40
        && (data.balance is int || data.balance is float)
        && data.balance >= 0
        && data.referralCode is string
        && data.referralCode.size() >= 6
        && data.referralCode.size() <= 16
        && data.referredBy is string
        && data.referredBy.size() <= 128
        && data.referredByCode is string
        && data.referredByCode.size() <= 16
        && data.referralCount is int
        && data.referralBonusEarned is number
        && data.colourWinStreak is int
        && data.jhandiWinStreak is int
        && (!('chickenWinStreak' in data) || data.chickenWinStreak is int)
        && (data.lastResetAtMs is int || data.lastResetAtMs is float)
        && data.followBonusClaimed is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId) && request.auth.uid == adminId;
      allow list, create, update, delete: if false;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if false;
      allow create: if false;
      allow update: if isVerifiedUser()
        && isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && (!('publicUid' in existing()) || ('publicUid' in incoming() && incoming().publicUid == existing().publicUid))
        && (!('publicUid' in incoming()) || ('publicUid' in existing()))
        && (!('mobile' in existing()) || ('mobile' in incoming() && incoming().mobile == existing().mobile))
        && (!('mobile' in incoming()) || ('mobile' in existing()))
        && (!('phoneNumber' in existing()) || ('phoneNumber' in incoming() && incoming().phoneNumber == existing().phoneNumber))
        && (!('phoneNumber' in incoming()) || ('phoneNumber' in existing()))
        && (!('authMethod' in existing()) || ('authMethod' in incoming() && incoming().authMethod == existing().authMethod))
        && (!('authMethod' in incoming()) || ('authMethod' in existing()))
        && incoming().email == existing().email
        && incoming().photoURL == existing().photoURL
        && incoming().balance == existing().balance
        && incoming().referralCode == existing().referralCode
        && incoming().referredBy == existing().referredBy
        && incoming().referredByCode == existing().referredByCode
        && incoming().referralCount == existing().referralCount
        && incoming().referralBonusEarned == existing().referralBonusEarned
        && incoming().colourWinStreak == existing().colourWinStreak
        && incoming().jhandiWinStreak == existing().jhandiWinStreak
        && (!('chickenWinStreak' in existing()) || incoming().chickenWinStreak == existing().chickenWinStreak)
        && incoming().lastResetAtMs == existing().lastResetAtMs
        && incoming().followBonusClaimed == existing().followBonusClaimed
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName',
          'updatedAt'
        ]);
      allow delete: if false;

      match /gameHistory/{historyId} {
        allow get: if isValidId(userId) && isValidId(historyId) && (isOwner(userId) || isAdmin());
        allow list: if isSignedIn() && request.auth.uid == userId && resource.data.uid == request.auth.uid;
        allow create, update, delete: if false;
      }

      match /transactions/{txId} {
        allow get: if isValidId(userId) && isValidId(txId) && (isOwner(userId) || isAdmin());
        allow list: if isSignedIn() && request.auth.uid == userId && resource.data.uid == request.auth.uid;
        allow create, update, delete: if false;
      }

      match /chickenSessions/{sessionId} {
        allow read, write: if false;
      }
    }

    match /adminTransactions/{txId} {
      allow get: if isValidId(txId) && isAdmin();
      allow list, create, update, delete: if false;
    }

    match /referrals/{code} {
      allow read, write: if false;
    }

    match /publicUserIds/{publicUid} {
      allow read, write: if false;
    }
  }
}
